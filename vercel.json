{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/index.ts": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/api/:route*", "destination": "/api/index?route=:route*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
